      "md": { "$value": "40px", "$type": "dimension", "$description": "Button md height, default." },
      "lg": { "$value": "48px", "$type": "dimension", "$description": "Button lg height." }
    },
    "control-compact": {
      "sm": {
        "$value": "28px",
        "$type": "dimension",
        "$description": "Button sm height under data-density=compact."
