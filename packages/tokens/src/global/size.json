      "md": {
        "$value": "32px",
        "$type": "dimension",
        "$description": "Button md height under data-density=compact."
      },
      "lg": {
        "$value": "40px",
        "$type": "dimension",
        "$description": "Button lg height under data-density=compact."
      }
    },
    "touch-target": {
      "$value": "44px",
      "$type": "dimension",
      "$description": "Minimum hit area on pointer: coarse."
    },
    "badge": {
      "sm": { "$value": "20px", "$type": "dimension", "$description": "Badge sm height." },
      "md": { "$value": "24px", "$type": "dimension", "$description": "Badge md height." }
