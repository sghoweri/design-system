{
  "name": "@salemcobalt/tokens",
  "version": "0.1.0",
  "description": "Design tokens for the Salem Cobalt design system: CSS custom properties, Sass, TypeScript and JSON from one Style Dictionary source.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sghoweri/design-system.git",
    "directory": "packages/tokens"
  },
  "type": "module",
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "main": "./dist/js/tokens.js",
  "types": "./dist/js/tokens.d.ts",
  "exports": {
    ".": {
      "types": "./dist/js/tokens.d.ts",
      "import": "./dist/js/tokens.js"
    },
    "./css": "./dist/css/tokens.css",
    "./scss": "./dist/scss/_tokens.scss",
    "./json": "./dist/json/tokens.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate:color": "node scripts/generate-color.mjs"
  },
  "devDependencies": {
    "style-dictionary": "^5.6.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
