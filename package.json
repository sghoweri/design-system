{
  "name": "design-system",
  "private": true,
  "version": "0.0.0",
  "description": "Protokit: a design system by Salem Cobalt. Publishes @protokit/tokens and @protokit/ui.",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "test": "pnpm -r --filter './packages/*' test && node --test 'scripts/*.test.mjs' && pnpm check:vars && pnpm check:manifest",
    "check:manifest": "pnpm --filter @protokit/ui manifest:check",
    "check:vars": "node scripts/check-vars.mjs packages/ui/src apps/docs/src",
    "check:names": "node scripts/codemod-namespace.mjs --check .",
    "lint:css": "stylelint 'packages/ui/src/styles/*.css' 'apps/docs/src/**/*.css'",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && prettier --check . && pnpm lint:css && pnpm check:names",
    "format": "prettier --write .",
    "storybook": "pnpm --filter storybook dev",
    "build-storybook": "pnpm --filter storybook build",
    "docs": "pnpm --filter docs dev",
    "build-docs": "pnpm --filter docs build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@nx/js": "^24.0.4",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.2",
    "globals": "^16.5.0",
    "nx": "^24.0.4",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
