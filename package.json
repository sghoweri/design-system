{
  "name": "design-system",
  "private": true,
  "version": "0.0.0",
  "description": "Salem Cobalt: a personal design system. Publishes @salemcobalt/tokens and @salemcobalt/ui.",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "test": "pnpm -r --filter './packages/*' test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "storybook": "pnpm --filter storybook dev",
    "build-storybook": "pnpm --filter storybook build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@nx/js": "^24.0.4",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.2",
    "globals": "^16.5.0",
    "nx": "^24.0.4",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
