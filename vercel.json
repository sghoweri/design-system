{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build && pnpm build-storybook && pnpm build-docs",
  "outputDirectory": "apps/docs/dist",
  "ignoreCommand": "git diff HEAD^ HEAD --quiet -- packages/ apps/storybook/ apps/docs/ pnpm-lock.yaml vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "query", "key": "path" }],
      "destination": "/workshop/",
      "permanent": true
    },
    { "source": "/iframe.html", "destination": "/workshop/iframe.html", "permanent": true },
    { "source": "/index.json", "destination": "/workshop/index.json", "permanent": true }
  ]
}
